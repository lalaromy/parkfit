# Copy to .env and fill in. All variables are optional.
# Google Places (optional fourth source). Without a key the Places ingest is skipped.
GOOGLE_PLACES_API_KEY=
# Storage backend. Leave empty for the zero-setup SQLite store (data/processed/parkfit.sqlite).
# For PostGIS run `docker compose up -d` and set:
# DATABASE_URL=postgresql+psycopg://parkfit:parkfit@localhost:5433/parkfit
DATABASE_URL=
# Identify yourself to Overpass / Nominatim as their usage policies require.
PARKFIT_USER_AGENT=parkfit-msc-project/0.1 (contact: your@email)
